PORT=5000
# Address of the React app (used in the welcome email link)
APP_URL=http://localhost:3000

# JWT signing secret: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# SQL Server
DB_SERVER=PRITI_LAPTOP
DB_NAME=ProductsDb
DB_USER=user1
DB_PASSWORD=change-me

# Email (SMTP): welcome email on user creation and summary email on save. Leave SMTP_HOST empty to only log emails to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM="Interactive Dashboard <you@gmail.com>"

# AI assistant (Claude) for the chat panel. Get a key at https://platform.claude.com/settings/keys.
# Leave empty to turn the AI assistant off (the rule-based chatbot still works).
ANTHROPIC_API_KEY=
